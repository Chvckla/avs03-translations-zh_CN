#. source: Shots land on the nearest enemy. 3% chance of a headshot.
msgid "UPGRADE.weapon_hitmarkers.description"
msgstr "Semua tembakan mendarat pada musuh terdekat. 3% peluang headshot."

#. Upgrade card - name (weapon_paint)
#. source: Paint
msgid "UPGRADE.weapon_paint.name"
msgstr ""

#. Upgrade card - description (weapon_paint)
#. source: Paints circles near the player that damage and add stacks of Lag to enemies over time.
msgid "UPGRADE.weapon_paint.description"
msgstr ""
"Melukis lingkaran disekitar pemain yang memkan dan menambah tumpukan Lag ke "
"musuh seiring waktu."

#. Upgrade card - name (weapon_pinball)
#. source: Pinball
msgid "UPGRADE.weapon_pinball.name"
msgstr ""

#. Upgrade card - description (weapon_pinball)
#. source: Shoots a bouncing ball towards the nearest enemy.
msgid "UPGRADE.weapon_pinball.description"
msgstr "Menembak bola kecil yang memantul terhadap musuh terdekat."

#. Upgrade card - name (weapon_quarantine)
#. source: Quarantine
msgid "UPGRADE.weapon_quarantine.name"
msgstr "Karantina"

#. Upgrade card - description (weapon_quarantine)
#. source: Scans an area around the player damaging enemies.
msgid "UPGRADE.weapon_quarantine.description"
msgstr "Memindai daerah disekitar pemain dan membahayakan musuh."

#. Upgrade card - name (weapon_search)
#. source: Search
msgid "UPGRADE.weapon_search.name"
msgstr "Pencarian"

#. Upgrade card - description (weapon_search)
#. source: Sends out a magnifying glass around the player.
msgid "UPGRADE.weapon_search.description"
msgstr "Mengeluarkan kaca pembesar disekitar pemain."

